# Dreaming settings. install.sh copies this to dreaming.env (gitignored) and fills in the root.
# Every value here is a placeholder: replace it with your own.

# The notes folder Dreaming reads (required). Ideally a git repo: commits date the notes.
DREAMING_ROOT=/path/to/your/notes

# Home for the outside roots (dictations, meeting transcripts, Claude Code memory). Default ~.
# DREAMING_HOME=/path/to/home

# Where the state and the nightly reports go. Default <root>/_meta/health/dreams.
# DREAMING_STATE=/path/to/state

# The time zone the night is measured in. Default: the Mac's own zone, else UTC.
# DREAMING_TZ=Europe/London

# Folders under home for dictations and meeting transcripts.
# DREAMING_DICTATIONS_DIR=vault/raw/inbox/dictations
# DREAMING_MEETINGS_DIR=Documents/Transcripts

# Folder names never read or written, comma-separated. Default career.
# DREAMING_DENIED_NAMES=career

# Your agent runner's markers that block live judge calls and writes, comma-separated.
# DREAMING_HEADLESS_VARS=STEWARD_RUN_ID

# The judge: the Claude Code CLI, logged in. Default `claude` on PATH, else ~/.local/bin/claude.
# DREAMING_CLAUDE=/path/to/claude
DREAMING_MODEL=haiku

# Claude Code memory folders to read, ':'-separated, relative to home. Default every
# ~/.claude/projects/*/memory folder.
# DREAMING_MEMORY_DIRS=.claude/projects/example-project/memory

# A file of private terms, one per line, that may never be written into a note's frontmatter.
# DREAMING_PRIVATE_TERMS=/path/to/private-terms.txt

# A command that answers "which knowledge bank pages exist for this title?" with JSON
# {"pages": [{"title": "..."}]}. Without it no bank proposals are made.
# DREAMING_BANK_CMD=/path/to/bank-lookup

# The usage snapshot your Claude Code status line writes. Default <root>/_meta/health/usage.json.
# DREAMING_USAGE_FILE=/path/to/usage.json
